{
  "linter": [
    "mslint:recommended",
    {
      "files": [
        "**/*.Script.txt"
      ],
      "msApiPath": "./doc.h",
      "rules": {
        "max-statements": ["error", { "maximum": 250 }],
        "no-empty": "error",
        "no-lonely-if": "error",
        "type-declaration": "off",
        "no-useless-concat": "off"
      }
    }
  ]
}